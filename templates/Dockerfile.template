FROM linuxserver/vscodium-web:latest                                                                                                                                                                                        
                                                                                                               
# 1. Install system dependencies (as root)
# Added openssh-server so we can configure sshd_config
RUN apt-get update && apt-get install -y \
    curl git wget zsh vim tmux jq build-essential unzip ripgrep rsync ca-certificates \
    python3 python3-pip python3.12-venv golang-go fontconfig sudo locales openssh-server libvulkan1 \
    && rm -rf /var/lib/apt/lists/* && \
    echo "abc ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/abc
                                                                                                                                                                                                                               
# Generate and set locales (Essential for Powerlevel10k, Zsh encoding, and Tmux)
RUN locale-gen en_US.UTF-8                                                                                                                                                                                                  
ENV LANG=en_US.UTF-8                                                                                                                                                                                                        
ENV LC_ALL=en_US.UTF-8                                                                                                                                                                                                      

# 1.5 Install GitHub CLI
RUN mkdir -p -m 755 /etc/apt/keyrings && \
    wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*
                                                                                                                                                                                                                               
# 2. Install Fonts
RUN mkdir -p /usr/share/fonts/truetype/meslo && \
    wget -q -P /usr/share/fonts/truetype/meslo https://github.com/romkatv/dotfiles-public/raw/master/.local/share/fonts/NerdFonts/MesloLGS%20NF%20Regular.ttf && \
    fc-cache -fv

# 3. Install gcloud SDK (Global location)
RUN mkdir -p /opt/google-cloud-sdk && \
    curl -O https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz && \
    tar -xf google-cloud-cli-linux-x86_64.tar.gz -C /opt && \
    rm google-cloud-cli-linux-x86_64.tar.gz && \
    /opt/google-cloud-sdk/install.sh --quiet

# 4. Global Tool Locations & Environment
ENV NVM_DIR=/opt/nvm
ENV OH_MY_ZSH=/opt/oh-my-zsh
ENV ZSH_CUSTOM=/opt/oh-my-zsh-custom
ENV ZSH_DISABLE_COMPFIX=true
# Pre-set PATH for build layers to find gcloud
ENV PATH=/opt/google-cloud-sdk/bin:$PATH
ENV CLAUDE_CODE_USE_VERTEX=1

# 5. Install NVM, Node, npm, Antigravity CLI (agy), Oh My Zsh, and P10k
RUN mkdir -p $NVM_DIR $OH_MY_ZSH $ZSH_CUSTOM && \
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash && \
    bash -c "source $NVM_DIR/nvm.sh && \
             nvm install 20 && \
             nvm alias default 20 && \
             npm install -g @openai/codex opencode-ai@latest" && \
    HOME=/tmp curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin && \
    chmod 755 /usr/local/bin/agy && rm -rf /tmp/.cache && \
    git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git $OH_MY_ZSH && \
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git $ZSH_CUSTOM/themes/powerlevel10k

# 6. Global Symlinks (Ensures tools are found regardless of shell login type)
RUN bash -c "source $NVM_DIR/nvm.sh && \
    ln -sf \$(which node) /usr/local/bin/node && \
    ln -sf \$(which npm) /usr/local/bin/npm"

# 7. Download a lean default Powerlevel10k config (for new users and root SSH sessions)
RUN wget -q -O /etc/skel/.p10k.zsh https://raw.githubusercontent.com/romkatv/powerlevel10k/master/config/p10k-lean.zsh && \
    cp /etc/skel/.p10k.zsh /root/.p10k.zsh

# 8. Create Global ZSH and Tmux Configurations (PVC Proof)
RUN mkdir -p /etc/zsh && \
    echo 'if [[ $EUID -eq 0 && "$(cat /proc/$PPID/comm 2>/dev/null)" == "nsenter.sh" && -z "$_CLOUDRUN_SSH_ABC" && -z "$LC_SSH_ROOT" ]]; then' > /etc/zsh/zshenv && \
    echo '  export _CLOUDRUN_SSH_ABC=1' >> /etc/zsh/zshenv && \
    echo '  export HOME=/home/workspace' >> /etc/zsh/zshenv && \
    echo '  export USER=abc' >> /etc/zsh/zshenv && \
    echo '  export LOGNAME=abc' >> /etc/zsh/zshenv && \
    echo '  export PATH="/home/workspace/.local/bin:/opt/nvm/versions/node/$(ls /opt/nvm/versions/node 2>/dev/null | tail -n 1)/bin:/opt/google-cloud-sdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' >> /etc/zsh/zshenv && \
    echo '  cd /home/workspace 2>/dev/null || true' >> /etc/zsh/zshenv && \
    echo '  if [[ -n "$SSH_ORIGINAL_COMMAND" ]]; then' >> /etc/zsh/zshenv && \
    echo '    _cmd="$SSH_ORIGINAL_COMMAND"' >> /etc/zsh/zshenv && \
    echo '    if [[ ( "$_cmd" == scp || "$_cmd" == scp\ * ) && -f "/.google_ssh/tools/scp" ]]; then' >> /etc/zsh/zshenv && \
    echo '      _cmd="/.google_ssh/tools/${_cmd}"' >> /etc/zsh/zshenv && \
    echo '    elif [[ ( "$_cmd" == /tools/sftp-server || "$_cmd" == /tools/sftp-server\ * ) && -f "/.google_ssh/tools/sftp-server" ]]; then' >> /etc/zsh/zshenv && \
    echo '      _cmd="/.google_ssh${_cmd}"' >> /etc/zsh/zshenv && \
    echo '    fi' >> /etc/zsh/zshenv && \
    echo '    exec /usr/bin/s6-setuidgid abc /bin/zsh -c "$_cmd"' >> /etc/zsh/zshenv && \
    echo '  else' >> /etc/zsh/zshenv && \
    echo '    exec /usr/bin/s6-setuidgid abc /bin/zsh -l' >> /etc/zsh/zshenv && \
    echo '  fi' >> /etc/zsh/zshenv && \
    echo 'fi' >> /etc/zsh/zshenv && \
    echo 'unsetopt WARN_CREATE_GLOBAL' > /etc/zsh/zshrc && \
    echo 'POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true' >> /etc/zsh/zshrc && \
    echo '[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh' >> /etc/zsh/zshrc && \
    echo 'export LANG=en_US.UTF-8' >> /etc/zsh/zshrc && \
    echo 'export LC_ALL=en_US.UTF-8' >> /etc/zsh/zshrc && \
    echo 'export ZSH_DISABLE_COMPFIX="true"' >> /etc/zsh/zshrc && \
    echo 'zsh-newuser-install() { :; }' >> /etc/zsh/zshrc && \
    echo '[ -f /etc/zsh/zshrc.gcp ] && source /etc/zsh/zshrc.gcp' >> /etc/zsh/zshrc && \
    echo 'export PATH=$HOME/.local/bin:$PATH:/opt/google-cloud-sdk/bin' >> /etc/zsh/zshrc && \
    echo '[[ -z "$TMUX" ]] && export TERM=xterm-256color' >> /etc/zsh/zshrc && \
    echo 'export ZSH="/opt/oh-my-zsh"' >> /etc/zsh/zshrc && \
    echo 'export ZSH_CUSTOM="/opt/oh-my-zsh-custom"' >> /etc/zsh/zshrc && \
    echo 'ZSH_THEME="powerlevel10k/powerlevel10k"' >> /etc/zsh/zshrc && \
    echo 'source $ZSH/oh-my-zsh.sh' >> /etc/zsh/zshrc && \
    echo 'export NVM_DIR="/opt/nvm"' >> /etc/zsh/zshrc && \
    echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> /etc/zsh/zshrc && \
    echo 'export CLAUDE_CODE_USE_VERTEX=1' >> /etc/zsh/zshrc

# Global Tmux Config
RUN echo 'set -g prefix C-a' > /etc/tmux.conf && \
    echo 'unbind C-b' >> /etc/tmux.conf && \
    echo 'bind C-a send-prefix' >> /etc/tmux.conf && \
    echo 'set -g default-terminal "tmux-256color"' >> /etc/tmux.conf && \
    echo 'set -ga terminal-overrides ",*256col*:Tc"' >> /etc/tmux.conf && \
    echo 'set -g default-shell /bin/zsh' >> /etc/tmux.conf

# 9. Configure SSHD to Accept Env and Force abc User
RUN mkdir -p /run/sshd /etc/ssh && \
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    echo "AcceptEnv LANG LC_*" >> /etc/ssh/sshd_config && \
    echo "AllowUsers abc" >> /etc/ssh/sshd_config

# 10. Finalize User Setup
RUN usermod -d /home/workspace -m abc && \
    usermod --shell /bin/zsh abc && \
    usermod --shell /bin/zsh root && \
    chown -R abc:abc /opt/nvm /opt/oh-my-zsh /opt/oh-my-zsh-custom && \
    chmod -R g-w,o-w /usr/share/zsh /usr/local/share/zsh 2>/dev/null || true


# 10.5. Install Orchestrator
RUN pip3 install fastapi uvicorn --break-system-packages && \
    mkdir -p /opt/orchestrator && \
    cat << 'EOF' > /opt/orchestrator/get_tmux_context.sh
#!/bin/bash
# Retrieves all tmux panes and their recent history (last 100 lines)

panes=$(tmux list-panes -a -F "#{pane_id} | Session: #{session_name} | Window: #{window_name} | Pane Index: #{pane_index} | Top: #{pane_top} | Left: #{pane_left} | Width: #{pane_width} | Height: #{pane_height} | Command: #{pane_current_command} | Path: #{pane_current_path}" 2>/dev/null || echo "No tmux panes found")

echo "=== TMUX PANES ==="
echo "$panes"
echo ""

if [ "$panes" != "No tmux panes found" ]; then
    for pane_id in $(tmux list-panes -a -F "#{pane_id}" 2>/dev/null); do
        echo "--- PANE $pane_id ---"
        pane_path=$(tmux display-message -p -t "$pane_id" -F "#{pane_current_path}")
        echo "Path: $pane_path"
        
        git_branch=$(git -C "$pane_path" branch --show-current 2>/dev/null)
        if [ -n "$git_branch" ]; then
            echo "Git Branch: $git_branch"
        fi
        
        echo "History (last 100 lines):"
        tmux capture-pane -p -t "$pane_id" -S -100 2>/dev/null || echo "Could not capture pane $pane_id"
        echo ""
    done
fi
EOF

RUN cat << 'EOF' > /opt/orchestrator/main.py
from fastapi import FastAPI, HTTPException
import subprocess
import json
import os

app = FastAPI(title="Tmux Summarizer API")

TMUX_SCRIPT_PATH = "/opt/orchestrator/get_tmux_context.sh"

@app.get("/api/panes")
async def get_tmux_summaries():
    try:
        if not os.path.exists(TMUX_SCRIPT_PATH):
            raise HTTPException(status_code=500, detail="Tmux summarizer script not found.")
            
        tmux_context = subprocess.run(["bash", TMUX_SCRIPT_PATH], capture_output=True, text=True, check=True)
        raw_output = tmux_context.stdout
        
        prompt = f"""
Using the provided Tmux terminal context, analyze the history of each pane.

For each pane, determine:
1. "initial_intent": The overall goal or reason this session was started.
2. "working_directory": The directory path.
3. "git_branch": The active git branch (or null).
4. "task_summary": What specific task or process is currently running.
5. "status": The state of the process (e.g. RUNNING, WAITING, ERROR).
6. "pane_index": The tmux pane index (e.g. 0, 1, 2).
7. "layout": An object containing the pane's exact coordinates and dimensions extracted from the header (e.g. {{"top": 0, "left": 84, "width": 158, "height": 42}}). Convert these string values to numbers.

Return a structured JSON array summarizing them. Keys: pane_id, window_name, pane_index, command, status, initial_intent, working_directory, git_branch, task_summary, layout.
Return ONLY valid JSON array without any markdown formatting.

<tmux_context>
{raw_output}
</tmux_context>
"""
        
        command = ["gemini", "-p", prompt, "--output-format", "json"]
        result = subprocess.run(command, capture_output=True, text=True, check=True)
        
        cli_output = json.loads(result.stdout)
        response_text = cli_output.get("response", "[]")
        
        if response_text.startswith("```json"):
            response_text = response_text[7:-3].strip()
        elif response_text.startswith("```"):
            response_text = response_text[3:-3].strip()
            
        panes_data = json.loads(response_text)
        return {"panes": panes_data}

    except subprocess.CalledProcessError as e:
        raise HTTPException(status_code=500, detail=f"Failed to execute process: {e.stderr}")
    except json.JSONDecodeError as e:
        raise HTTPException(status_code=500, detail=f"Failed to parse JSON response: {str(e)}")
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8001)
EOF

RUN chmod +x /opt/orchestrator/get_tmux_context.sh && \
    mkdir -p /custom-services.d && \
    echo '#!/usr/bin/with-contenv bash' > /custom-services.d/orchestrator && \
    echo 'exec s6-setuidgid abc uvicorn main:app --host 0.0.0.0 --port 8001 --app-dir /opt/orchestrator' >> /custom-services.d/orchestrator && \
    chmod 755 /custom-services.d/orchestrator

# 10.8. Cloud Run Instances Local-Disk + GCS Background Sync Service
# When a GCS volume is mounted at /mnt/gcs-workspace, /home/workspace runs on fast local disk
# and syncs incrementally to /mnt/gcs-workspace every 30s and on graceful shutdown (SIGTERM).
RUN echo '#!/bin/bash' > /usr/local/bin/workspace-sync-now && \
    echo 'set -euo pipefail' >> /usr/local/bin/workspace-sync-now && \
    echo 'umask 000' >> /usr/local/bin/workspace-sync-now && \
    echo 'if ! grep -qs " /mnt/gcs-workspace " /proc/mounts || grep -qs " /home/workspace " /proc/mounts; then exit 0; fi' >> /usr/local/bin/workspace-sync-now && \
    echo 'if [ ! -f /run/workspace-hydrated ]; then echo "[workspace-sync] Skipping sync: /run/workspace-hydrated sentinel not found." >&2; exit 0; fi' >> /usr/local/bin/workspace-sync-now && \
    echo 'mkdir -p -m 777 /run/workspace-sync' >> /usr/local/bin/workspace-sync-now && \
    echo 'chmod 777 /run/workspace-sync 2>/dev/null || true' >> /usr/local/bin/workspace-sync-now && \
    echo 'LOCK_FLAG="-n"' >> /usr/local/bin/workspace-sync-now && \
    echo 'FULL_DELETE=0' >> /usr/local/bin/workspace-sync-now && \
    echo 'for arg in "$@"; do' >> /usr/local/bin/workspace-sync-now && \
    echo '  case "$arg" in' >> /usr/local/bin/workspace-sync-now && \
    echo '    --wait) LOCK_FLAG="" ;;' >> /usr/local/bin/workspace-sync-now && \
    echo '    --full-delete) FULL_DELETE=1 ;;' >> /usr/local/bin/workspace-sync-now && \
    echo '  esac' >> /usr/local/bin/workspace-sync-now && \
    echo 'done' >> /usr/local/bin/workspace-sync-now && \
    echo 'exec 9>/run/workspace-sync/lock' >> /usr/local/bin/workspace-sync-now && \
    echo 'if ! flock ${LOCK_FLAG} 9; then exit 0; fi' >> /usr/local/bin/workspace-sync-now && \
    echo '(cd /home/workspace && find . -mindepth 1 \( -name "node_modules" -o -name "venv" -o -name ".venv" -o -name "__pycache__" -o -name ".pytest_cache" -o -name ".mypy_cache" -o -name ".ruff_cache" -o -name ".cache" -o -name ".gemini" -o -name ".npm" -o -name ".tmp" -o -name "server_state" -o -name "lost+found" \) -prune -o \( ! -type s ! -type p \) -print0 | LC_ALL=C sort -z) > /run/workspace-sync/manifest.new' >> /usr/local/bin/workspace-sync-now && \
    echo 'if [ -f /run/workspace-sync/manifest ]; then' >> /usr/local/bin/workspace-sync-now && \
    echo '  LC_ALL=C comm -z -23 /run/workspace-sync/manifest /run/workspace-sync/manifest.new > /run/workspace-sync/deleted.list' >> /usr/local/bin/workspace-sync-now && \
    echo '  if [ -s /run/workspace-sync/deleted.list ]; then' >> /usr/local/bin/workspace-sync-now && \
    echo '    (cd /mnt/gcs-workspace && xargs -0 -r -P 16 rm -f -- < /run/workspace-sync/deleted.list 2>/dev/null || true)' >> /usr/local/bin/workspace-sync-now && \
    echo '    (cd /mnt/gcs-workspace && LC_ALL=C sort -z -r /run/workspace-sync/deleted.list | xargs -0 -r rm -rf --)' >> /usr/local/bin/workspace-sync-now && \
    echo '  fi' >> /usr/local/bin/workspace-sync-now && \
    echo '  rm -f /run/workspace-sync/deleted.list' >> /usr/local/bin/workspace-sync-now && \
    echo 'fi' >> /usr/local/bin/workspace-sync-now && \
    echo 'DELETE_FLAG=""' >> /usr/local/bin/workspace-sync-now && \
    echo 'if [ "$FULL_DELETE" -eq 1 ]; then DELETE_FLAG="--delete"; fi' >> /usr/local/bin/workspace-sync-now && \
    echo 'sync_item() {' >> /usr/local/bin/workspace-sync-now && \
    echo '  local rc=0' >> /usr/local/bin/workspace-sync-now && \
    echo '  rsync -rltO --inplace --no-perms --no-owner --no-group ${DELETE_FLAG} --exclude="node_modules" --exclude="venv" --exclude=".venv" --exclude="__pycache__" --exclude=".pytest_cache" --exclude=".mypy_cache" --exclude=".ruff_cache" --exclude=".cache" --exclude=".gemini" --exclude=".npm" --exclude=".tmp" --exclude="server_state" --exclude="lost+found" "$1" /mnt/gcs-workspace/ || rc=$?' >> /usr/local/bin/workspace-sync-now && \
    echo '  [ "$rc" -eq 0 ] || [ "$rc" -eq 24 ]' >> /usr/local/bin/workspace-sync-now && \
    echo '}' >> /usr/local/bin/workspace-sync-now && \
    echo 'export -f sync_item' >> /usr/local/bin/workspace-sync-now && \
    echo 'export DELETE_FLAG' >> /usr/local/bin/workspace-sync-now && \
    echo 'find /home/workspace -mindepth 1 -maxdepth 1 ! -name "node_modules" ! -name "venv" ! -name ".venv" ! -name "__pycache__" ! -name ".pytest_cache" ! -name ".mypy_cache" ! -name ".ruff_cache" ! -name ".cache" ! -name ".gemini" ! -name ".npm" ! -name ".tmp" ! -name "server_state" ! -name "lost+found" -print0 | xargs -0 -r -P 16 -I {} bash -c "sync_item \"\$1\"" _ "{}"' >> /usr/local/bin/workspace-sync-now && \
    echo 'mv -f /run/workspace-sync/manifest.new /run/workspace-sync/manifest' >> /usr/local/bin/workspace-sync-now && \
    echo 'chmod 666 /run/workspace-sync/manifest /run/workspace-sync/lock 2>/dev/null || true' >> /usr/local/bin/workspace-sync-now && \
    chmod 755 /usr/local/bin/workspace-sync-now

RUN mkdir -p /custom-services.d && \
    echo '#!/usr/bin/with-contenv bash' > /custom-services.d/workspace-sync && \
    echo 'SYNC_INTERVAL="${WORKSPACE_SYNC_INTERVAL:-30}"' >> /custom-services.d/workspace-sync && \
    echo 'if ! grep -qs " /mnt/gcs-workspace " /proc/mounts || grep -qs " /home/workspace " /proc/mounts; then' >> /custom-services.d/workspace-sync && \
    echo '  echo "[workspace-sync] /mnt/gcs-workspace not mounted (or /home/workspace is a volume mount); background sync daemon idle."' >> /custom-services.d/workspace-sync && \
    echo '  exec sleep infinity' >> /custom-services.d/workspace-sync && \
    echo 'fi' >> /custom-services.d/workspace-sync && \
    echo 'echo "[workspace-sync] Starting background sync daemon (/home/workspace -> /mnt/gcs-workspace every ${SYNC_INTERVAL}s)..."' >> /custom-services.d/workspace-sync && \
    echo 'shutdown_sync() {' >> /custom-services.d/workspace-sync && \
    echo '  echo "[workspace-sync] Caught termination signal, flushing final changes to /mnt/gcs-workspace..."' >> /custom-services.d/workspace-sync && \
    echo '  /usr/local/bin/workspace-sync-now --wait || true' >> /custom-services.d/workspace-sync && \
    echo '  echo "[workspace-sync] Final sync complete."' >> /custom-services.d/workspace-sync && \
    echo '  exit 0' >> /custom-services.d/workspace-sync && \
    echo '}' >> /custom-services.d/workspace-sync && \
    echo 'trap shutdown_sync SIGTERM SIGINT SIGHUP' >> /custom-services.d/workspace-sync && \
    echo 'while true; do' >> /custom-services.d/workspace-sync && \
    echo '  sleep "${SYNC_INTERVAL}" &' >> /custom-services.d/workspace-sync && \
    echo '  SLEEP_PID=$!' >> /custom-services.d/workspace-sync && \
    echo '  wait "${SLEEP_PID}" || true' >> /custom-services.d/workspace-sync && \
    echo '  /usr/local/bin/workspace-sync-now || true' >> /custom-services.d/workspace-sync && \
    echo 'done' >> /custom-services.d/workspace-sync && \
    chmod 755 /custom-services.d/workspace-sync

# 11. Runtime Initialization Script (runs on every container start via S6)
# Hydrates /home/workspace from /mnt/gcs-workspace (if mounted), fixes ownership and .ssh permissions,
# propagates GCP env vars, and activates gcloud
RUN mkdir -p /custom-cont-init.d && \
    echo '#!/bin/bash' > /custom-cont-init.d/99-setup-user && \
    echo 'mkdir -p /home/workspace' >> /custom-cont-init.d/99-setup-user && \
    echo 'mkdir -p -m 777 /run/workspace-sync' >> /custom-cont-init.d/99-setup-user && \
    echo 'chmod 777 /run/workspace-sync 2>/dev/null || true' >> /custom-cont-init.d/99-setup-user && \
    echo 'if grep -qs " /mnt/gcs-workspace " /proc/mounts && ! grep -qs " /home/workspace " /proc/mounts; then' >> /custom-cont-init.d/99-setup-user && \
    echo '  echo "[workspace-init] Hydrating local /home/workspace from /mnt/gcs-workspace (parallel rsync)..."' >> /custom-cont-init.d/99-setup-user && \
    echo '  if (set -o pipefail; find /mnt/gcs-workspace -mindepth 1 -maxdepth 1 ! -name "node_modules" ! -name "venv" ! -name ".venv" ! -name "__pycache__" ! -name ".pytest_cache" ! -name ".mypy_cache" ! -name ".ruff_cache" ! -name ".cache" ! -name ".gemini" ! -name ".npm" ! -name ".tmp" ! -name "server_state" ! -name "lost+found" -print0 | xargs -0 -r -P 16 -I {} rsync -a --no-D --exclude="node_modules" --exclude="venv" --exclude=".venv" --exclude="__pycache__" --exclude=".pytest_cache" --exclude=".mypy_cache" --exclude=".ruff_cache" --exclude=".cache" --exclude=".gemini" --exclude=".npm" --exclude=".tmp" --exclude="server_state" --exclude="lost+found" "{}" /home/workspace/); then' >> /custom-cont-init.d/99-setup-user && \
    echo '    for g in /home/workspace/*/.git; do [ -d "$g" ] || continue; r="${g%/.git}"; chmod -R a-x,u+rwX,go+rX "$r"; git -c safe.directory="*" -C "$r" ls-files -s 2>/dev/null | awk '\''$1 == "100755" {print substr($0, 51)}'\'' | xargs -r -I {} chmod +x "$r/{}"; done' >> /custom-cont-init.d/99-setup-user && \
    echo '    (cd /home/workspace && find . -mindepth 1 \( -name "node_modules" -o -name "venv" -o -name ".venv" -o -name "__pycache__" -o -name ".pytest_cache" -o -name ".mypy_cache" -o -name ".ruff_cache" -o -name ".cache" -o -name ".gemini" -o -name ".npm" -o -name ".tmp" -o -name "server_state" -o -name "lost+found" \) -prune -o \( ! -type s ! -type p \) -print0 | LC_ALL=C sort -z) > /run/workspace-sync/manifest' >> /custom-cont-init.d/99-setup-user && \
